\@writefile{toc}{\contentsline {section}{\numberline {5}Extrapolation beyond the training domain}{8}{section.5}\protected@file@percent }
\newlabel{sec:extrapolation}{{5}{8}{Extrapolation beyond the training domain}{section.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Extrapolation beyond the domain $[0,1]$ used in the search. Maximum error relative to $\max |u|$. The Chebyshev polynomial is fitted to the reference on $[0,1]$ with the \emph  {lowest degree that matches PISR-NSGA-II's accuracy inside the domain}, so both start equally accurate; the difference outside is what knowing the equation buys. Lower error in $[1,1.5]$ in bold. $^\dagger $the reference solution blows up before $x=1.5$; the interval is truncated there.}}{8}{table.caption.6}\protected@file@percent }
\newlabel{tab:extrapolation}{{5}{8}{Extrapolation beyond the domain $[0,1]$ used in the search. Maximum error relative to $\max |u|$. The Chebyshev polynomial is fitted to the reference on $[0,1]$ with the \emph {lowest degree that matches PISR-NSGA-II's accuracy inside the domain}, so both start equally accurate; the difference outside is what knowing the equation buys. Lower error in $[1,1.5]$ in bold. $^\dagger $the reference solution blows up before $x=1.5$; the interval is truncated there}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Champion (dashed), matched-accuracy Chebyshev polynomial (dotted) and reference (grey) on $[0,1.5]$; shaded region: outside the training domain.}}{9}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pointwise error of the champion and of the matched-accuracy Chebyshev polynomial on $[0,1.5]$.}}{9}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Physical consistency of the formulas}{10}{section.6}\protected@file@percent }
\newlabel{sec:physics}{{6}{10}{Physical consistency of the formulas}{section.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Physical consistency of the discovered formulas: quantities a physicist would extract from the solution, computed \emph  {from the formula} (symbolic derivatives, roots, limits) and compared with their known values. Status by relative error: \textcolor {good}{\textbullet }\ $<1\,\%$, \textcolor {fair}{\textbullet }\ $<10\,\%$, \textcolor {poor}{\textbullet }\ $\geq 10\,\%$, \textcolor {muted}{\textbullet }\ no result. The Lane--Emden radius and the Ginzburg--Landau far field lie outside the domain $[0,1]$ used in the search.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:physics}{{6}{10}{Physical consistency of the discovered formulas: quantities a physicist would extract from the solution, computed \emph {from the formula} (symbolic derivatives, roots, limits) and compared with their known values. Status by relative error: \stgood \ $<1\,\%$, \stfair \ $<10\,\%$, \stpoor \ $\geq 10\,\%$, \stnone \ no result. The Lane--Emden radius and the Ginzburg--Landau far field lie outside the domain $[0,1]$ used in the search}{table.caption.9}{}}
