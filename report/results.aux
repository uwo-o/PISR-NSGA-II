\@writefile{toc}{\contentsline {section}{\numberline {9}Discovered expressions}{34}{section.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Discovered closed-form solutions $\hat  u$ (hall-of-fame champion after constant polishing), simplified with SymPy and verified against the champion on its export grid (maximum relative difference below $10^{-3}$; constants to 4 significant figures). For 2D problems whose champion uses the boundary ansatz, $\mathcal  {C}[g]$ is the transfinite (Coons) interpolation of the boundary data $g$, so $\hat  u = g$ on $\partial [0,1]^2$ exactly. External symbolic baselines (PySR, PySINDy) are omitted: their runs predate the current problem definitions.}}{34}{table.7}\protected@file@percent }
\newlabel{tab:formulas}{{7}{34}{Discovered closed-form solutions $\hat u$ (hall-of-fame champion after constant polishing), simplified with SymPy and verified against the champion on its export grid (maximum relative difference below $10^{-3}$; constants to 4 significant figures). For 2D problems whose champion uses the boundary ansatz, $\mathcal {C}[g]$ is the transfinite (Coons) interpolation of the boundary data $g$, so $\hat u = g$ on $\partial [0,1]^2$ exactly. External symbolic baselines (PySR, PySINDy) are omitted: their runs predate the current problem definitions}{table.7}{}}
